sequenceDiagram
    actor Client
    participant Router as FastAPI Router
    participant Sec as legacy_identity
    participant Svc as RequirementService
    participant Repo as TaskRepository
    participant DB as SQLite

    Client->>Router: GET /api/tasks?owner=...
    Router->>Sec: Validate Authorization header
    Sec-->>Router: Identity(username, role)
    Router->>Svc: list_tasks(owner, identity)
    Svc->>Svc: _authorized_owner(...)
    Svc->>Repo: list_by_owner(requested_owner)
    Repo->>DB: SELECT tasks by owner
    DB-->>Repo: rows
    Repo-->>Svc: rows
    Svc->>Svc: map rows -> TaskResponse
    Svc-->>Router: TaskResponse[]
    Router-->>Client: 200 OK + TaskResponse[]
